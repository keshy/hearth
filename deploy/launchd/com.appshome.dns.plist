<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Runs as root: macOS only lets non-root processes bind port 53 on the
     wildcard address, and the fallback binds the LAN IP directly. -->
<dict>
  <key>Label</key><string>com.appshome.dns</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BIN__</string>
    <string>dns</string>
    <string>--data</string>
    <string>__DATA__</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>__DATA__/logs/dns.log</string>
  <key>StandardErrorPath</key><string>__DATA__/logs/dns.log</string>
</dict>
</plist>
